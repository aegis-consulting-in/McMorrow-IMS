# Copy to .env.local and fill in values from the Supabase project
# (Settings → API). See docs/SUPABASE_SETUP.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used in password-reset links. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Used only by `npm run seed`.
SEED_DEMO_PASSWORD=McMorrowIMS123!

DB_PASSWORD=YOUR_DB_PASSWORD
